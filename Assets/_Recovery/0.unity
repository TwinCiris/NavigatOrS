--- !u!114 &72361765
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 72361763}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2b660e3fb3953b346ab6f204dff6745e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  textoPregunta: {fileID: 280602679}
  textoMensaje: {fileID: 1071916257}
  liquidoRAM: {fileID: 1320559047}
  liquidoROM: {fileID: 591323302}
  pickUpScript: {fileID: 1383091286}
  preguntas:
  - texto: "Necesito cargar texturas 4K y geometr\xEDa de un nivel mientras el jugador
      explora."
    esRAM: 1
  - texto: "Soy el espacio donde el procesador guarda resultados intermedios de c\xE1lculos
      complejos."
    esRAM: 1
  - texto: "Almaceno las tablas de caracteres y fuentes b\xE1sicas para mostrar texto
      al encender."
    esRAM: 0
  - texto: El sistema me utiliza para realizar el 'Swap' o intercambio cuando el
      almacenamiento es lento.
    esRAM: 1
  - texto: "Contengo el c\xF3digo del cargador de arranque (Bootloader) que localiza
      al sistema operativo."
    esRAM: 0
  - texto: Soy el chip que guarda el firmware de control en un controlador de lavadora
      industrial.
    esRAM: 0
  - texto: "Almaceno los microc\xF3digos de correcci\xF3n de errores (ECC) integrados
      en el hardware."
    esRAM: 0
  - texto: Almaceno los procesos en segundo plano de las aplicaciones que minimizaste.
    esRAM: 1
  - texto: "Si me quedo sin espacio, el sistema operativo cerrar\xE1 aplicaciones
      para evitar colapsar."
    esRAM: 1
  - texto: "Guardo las rutinas de autodiagn\xF3stico (POST) que verifican el estado
      del teclado y mouse."
    esRAM: 0
  fuenteAudio: {fileID: 72361766}
  sonidoCorrecto: {fileID: 8300000, guid: 52d0017d91fb8ed45897d720030ba9a9, type: 3}
  sonidoError: {fileID: 8300000, guid: b2281e921d855b84689e3ad9bc2b98ec, type: 3}
  sonidoVictoria: {fileID: 8300000, guid: ce5c6ee143c7c1b409134cfb12729ba5, type: 3}
